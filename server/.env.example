PORT=4000
NODE_ENV=development

# Generate a long random string for production — never reuse this dev value.
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_EXPIRES_IN=7d

CLIENT_URL=http://localhost:5173
DB_PATH=./database/elora.sqlite

# Used only by database/seed.js to create the first admin account.
ADMIN_SEED_EMAIL=admin@elorapatisserie.com
ADMIN_SEED_PASSWORD=change-me-before-seeding

# Stripe — get real keys from https://dashboard.stripe.com/apikeys
# Leave blank in development to see the "payment gateway not configured" message
# instead of a fake/simulated payment success.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Fallback delivery fee (RM) used only if the business_settings table has no
# delivery_fee row yet. The live value is managed in Admin Settings.
DELIVERY_FEE=25
