{
  "name": "elora-patisserie",
  "private": true,
  "type": "module",
  "description": "Élora Patisserie — React site (client/) + Express API (server/) deployed together on Vercel",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm --prefix client run build",
    "start": "npm --prefix client run build && node server/server.js",
    "seed": "node server/database/seed.js"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@vercel/blob": "^2.8.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^7.3.2",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.0",
    "multer": "^2.2.0",
    "stripe": "^22.6.0"
  }
}
